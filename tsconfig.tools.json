{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // `scripts/screenshots.ts` evaluates callbacks inside the browser via Playwright,
    // so the tooling project needs DOM types even though it runs under Node.
    "types": ["node"],
    "outDir": ".tsbuild/tools"
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    // Pure server-domain modules, so `tests/roomUpkeep.test.ts` can reach the rules
    // it covers. Deliberately not `server/src/**`: RoomDO, the worker entry and the
    // HTTP responses are written against `@cloudflare/workers-types`, and compiling
    // those here would resolve `WebSocket`/`Response` to the DOM versions instead.
    "server/src/ids.ts",
    "server/src/match.ts",
    "server/src/pacingLog.ts",
    "server/src/finale.ts",
    "server/src/qa.ts",
    "server/src/roomState.ts",
    "server/src/roomUpkeep.ts",
    "server/src/story.ts",
    "server/src/types.ts",
    "web/src/brand.ts",
    "shared/**/*.ts",
    "content/**/*.ts",
    "vitest.config.ts"
  ]
}
